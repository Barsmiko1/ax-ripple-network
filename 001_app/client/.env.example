# =============================================================================
# AX Ripple Network — WebSocket Client Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values.
#
# To get the HAProxy IP after deploying infrastructure:
#   cd 004_terraform && terraform output haproxy_public_ip
#
# Or from Atlantis / AWS Console:
#   aws cloudformation describe-stacks --stack-name ax-ripple-dev-haproxy \
#     --query 'Stacks[0].Outputs[?OutputKey==`HAProxyPublicIP`].OutputValue' \
#     --output text
# =============================================================================

# HAProxy Public IP or DNS (from Terraform output)
# Replace with your actual HAProxy endpoint after deployment
HAPROXY_HOST=<haproxy-public-ip>

# HAProxy WebSocket endpoint (port 6006)
RIPPLED_WS_URL=ws://${HAPROXY_HOST}:6006

# HAProxy HTTP/JSON-RPC endpoint (port 80)
RIPPLED_HTTP_URL=http://${HAPROXY_HOST}:80

# HAProxy Stats dashboard (port 8404)
HAPROXY_STATS_URL=http://${HAPROXY_HOST}:8404/stats

# Reconnection settings (milliseconds)
RECONNECT_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=30000
