# =============================================================================
# Dockerfile — Rippled Validator Node (Multi-Stage)
# =============================================================================
# Lightweight production image for rippled validator nodes.
#   Stage 1 (builder): Add Ripple apt repo GPG key
#   Stage 2 (runtime): Install rippled + minimal runtime deps
#
# Build:
#   docker build -t ax-ripple-validator -f Dockerfile.validator .
#   # On Apple Silicon (ARM) machines, add: --platform linux/amd64
#
# The build context should be the repo root so 002_configs/ is accessible.
# =============================================================================

# ===========================================================================
# Stage 1 — Builder: Fetch GPG key for Ripple apt repository
# ===========================================================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Download and dearmor the Ripple GPG key
RUN mkdir -p /usr/local/share/keyrings && \
    wget -q -O - "https://repos.ripple.com/repos/api/gpg/key/public" | \
    gpg --dearmor > /usr/local/share/keyrings/ripple.gpg

# ===========================================================================
# Stage 2 — Runtime: Slim image with rippled installed from apt
# ===========================================================================
FROM debian:bookworm-slim AS runtime

LABEL maintainer="AX Ripple Network Team"
LABEL description="Rippled validator node for AX Ripple Network"
LABEL role="validator"

ENV DEBIAN_FRONTEND=noninteractive

# Install ca-certificates first (required for HTTPS apt repos)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy GPG key from builder
COPY --from=builder /usr/local/share/keyrings/ripple.gpg /usr/local/share/keyrings/ripple.gpg

# Add Ripple apt repository and install rippled + minimal runtime deps
RUN echo "deb [signed-by=/usr/local/share/keyrings/ripple.gpg] https://repos.ripple.com/repos/rippled-deb focal stable" \
    > /etc/apt/sources.list.d/ripple.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    rippled \
    curl \
    bash \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security (rippled package may already create this)
RUN (groupadd -r rippled 2>/dev/null || true) && (useradd -r -g rippled -m rippled 2>/dev/null || true)

# Create data and log directories
RUN mkdir -p /var/lib/rippled/db /var/log/rippled /etc/opt/ripple && \
    chown -R rippled:rippled /var/lib/rippled /var/log/rippled /etc/opt/ripple

# Copy validator configuration
COPY --chown=rippled:rippled 002_configs/rippled/validator.cfg /etc/opt/ripple/rippled.cfg

# Copy entrypoint script (handles dynamic seed injection + peer discovery)
COPY --chown=rippled:rippled 001_app/docker/entrypoint-validator.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Expose peer protocol port only (validators are private)
EXPOSE 51235

# Health check — rippled JSON-RPC on admin port
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -sf http://127.0.0.1:5005/ || exit 1

# Data volume
VOLUME ["/var/lib/rippled/db"]

# Run as non-root
USER rippled

# Entrypoint handles seed injection, peer config, then starts rippled
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

