# =============================================================================
# Dockerfile — Rippled API (Stock) Node (Multi-Stage)
# =============================================================================
# ===========================================================================
# Stage 1 — Builder: Fetch GPG key for Ripple apt repository
# ===========================================================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Download and dearmor the Ripple GPG key
RUN mkdir -p /usr/local/share/keyrings && \
    wget -q -O - "https://repos.ripple.com/repos/api/gpg/key/public" | \
    gpg --dearmor > /usr/local/share/keyrings/ripple.gpg

# ===========================================================================
# Stage 2 — Runtime: Slim image with rippled installed from apt
# ===========================================================================
FROM debian:bookworm-slim AS runtime

LABEL maintainer="AX Ripple Network Team"
LABEL description="Rippled API node for AX Ripple Network"
LABEL role="api-node"

ENV DEBIAN_FRONTEND=noninteractive

# Install ca-certificates first (required for HTTPS apt repos)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy GPG key from builder
COPY --from=builder /usr/local/share/keyrings/ripple.gpg /usr/local/share/keyrings/ripple.gpg

# Add Ripple apt repository and install rippled + minimal runtime deps
RUN echo "deb [signed-by=/usr/local/share/keyrings/ripple.gpg] https://repos.ripple.com/repos/rippled-deb focal stable" \
    > /etc/apt/sources.list.d/ripple.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    rippled \
    curl \
    bash \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security (rippled package may already create this)
RUN (groupadd -r rippled 2>/dev/null || true) && (useradd -r -g rippled -m rippled 2>/dev/null || true)

# Create data and log directories
RUN mkdir -p /var/lib/rippled/db /var/log/rippled /etc/opt/ripple && \
    chown -R rippled:rippled /var/lib/rippled /var/log/rippled /etc/opt/ripple

# Copy API node configuration
COPY --chown=rippled:rippled 002_configs/rippled/api-node.cfg /etc/opt/ripple/rippled.cfg

# Copy a blank validators.txt to override the mainnet default installed by the rippled package.
# The entrypoint will overwrite this with private network keys from Secrets Manager at runtime.
COPY --chown=rippled:rippled 002_configs/rippled/validators.txt /etc/opt/ripple/validators.txt

# Copy entrypoint script (handles peer discovery + validators.txt)
COPY --chown=rippled:rippled 001_app/docker/entrypoint-api-node.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Expose ports:
#   5005  - HTTP JSON-RPC (HAProxy backend)
#   6006  - WebSocket (HAProxy backend)
#   51235 - Peer protocol (internal mesh)
EXPOSE 5005 6006 51235

# Health check — rippled JSON-RPC
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -sf http://127.0.0.1:5005/ || exit 1

# Data volume
VOLUME ["/var/lib/rippled/db"]

# Run as non-root
USER rippled

# Entrypoint handles peer config, validators.txt, then starts rippled
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

